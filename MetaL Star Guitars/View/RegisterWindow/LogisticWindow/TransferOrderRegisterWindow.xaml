<Window x:Class="MetaL_Star_Guitars.View.RegisterWindow.TransferOrderRegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MetaL Star Guitars" Height="490" Width="1060" Background="#FF252525">

    <Grid x:Name="_mainGrid">

        <Label x:Name="_warehouseManagementTransfersTitleLabel" Content="Transfer order" Margin="10,10,0,0" VerticalAlignment="Top" FontSize="36" Foreground="White" FontFamily="Arial Black" HorizontalAlignment="Left" Width="481"/>

        <Label x:Name="_warehouseManagementTransfersSenderWarehouseLabel" Content="Sender warehouse" Margin="10,80,0,0" VerticalAlignment="Top" FontSize="24" Foreground="White" FontFamily="Arial Black" HorizontalAlignment="Left" Width="262"/>
        <ComboBox x:Name="_warehouseManagementTransfersSenderWarehouseComboBox" HorizontalAlignment="Left" Margin="332,83,0,0" VerticalAlignment="Top" Width="293" Background="#FF161616" FontSize="22" FontFamily="Arial Black" SelectionChanged="warehouseManagementTransfersSenderWarehouseComboBox_SelectionChanged"/>

        <Label x:Name="_warehouseManagementTransfersRecipientWarehouseLabel" Content="Recipient warehouse" Margin="10,123,0,0" VerticalAlignment="Top" FontSize="24" Foreground="White" FontFamily="Arial Black" HorizontalAlignment="Left" Width="295"/>
        <ComboBox x:Name="_warehouseManagementTransfersRecipientWarehouseComboBox" HorizontalAlignment="Left" Margin="332,126,0,0" VerticalAlignment="Top" Width="293" Background="#FF161616" FontSize="22" FontFamily="Arial Black" SelectionChanged="warehouseManagementTransfersRecipientWarehouseComboBox_SelectionChanged"/>

        <Label x:Name="_warehouseManagementTransfersRouteLabel" Content="Route" Margin="10,166,0,0" VerticalAlignment="Top" FontSize="24" Foreground="White" FontFamily="Arial Black" HorizontalAlignment="Left" Width="95"/>
        <ComboBox x:Name="_warehouseManagementTransfersRouteComboBox" HorizontalAlignment="Left" Margin="332,169,0,0" VerticalAlignment="Top" Width="293" Background="#FF161616" FontSize="22" FontFamily="Arial Black" SelectionChanged="warehouseManagementTransfersRouteComboBox_SelectionChanged"/>

        <Label x:Name="_warehouseManagementTransfersContentLabel" Content="Content" Margin="655,80,0,0" VerticalAlignment="Top" FontSize="24" Foreground="White" FontFamily="Arial Black" HorizontalAlignment="Left" Width="122"/>
        <Label x:Name="_warehouseManagementTransfersOrderIdTitleLabel" Content="Order ID" FontSize="24" Foreground="White" FontFamily="Arial Black" Margin="11,205,0,0" HorizontalAlignment="Left" Width="294" Height="37" VerticalAlignment="Top"/>
        <Label x:Name="_warehouseManagementTransfersOrderIdLabel" Content="1" FontSize="24" Foreground="White" FontFamily="Arial Black" Margin="332,205,0,0" Height="38" VerticalAlignment="Top" HorizontalAlignment="Left" Width="293"/>
        <Label x:Name="_warehouseManagementTransfersStatusTitleLabel" Content="Status" FontSize="24" Foreground="White" FontFamily="Arial Black" Margin="11,242,0,0" Height="38" VerticalAlignment="Top" HorizontalAlignment="Left" Width="228"/>
        <Label x:Name="_warehouseManagementTransfersStatusLabel" Content="Open" FontSize="24" Foreground="White" FontFamily="Arial Black" Margin="332,242,0,0" Height="38" VerticalAlignment="Top" HorizontalAlignment="Left" Width="293"/>
        <Label x:Name="_warehouseManagementTransfersShipmentDateTitleLabel" Content="Shipment date" FontSize="24" Foreground="White" FontFamily="Arial Black" Margin="11,280,0,0" Height="38" VerticalAlignment="Top" HorizontalAlignment="Left" Width="228"/>
        <Label x:Name="_warehouseManagementTransfersShipmentDateLabel" Content="18:45 17.05.2026" FontSize="24" Foreground="White" FontFamily="Arial Black" Margin="332,280,0,0" Height="38" VerticalAlignment="Top" HorizontalAlignment="Left" Width="293"/>
        <Label x:Name="_warehouseManagementTransfersReceiptDateLabel" Content="18:45 17.05.2026" FontSize="24" Foreground="White" FontFamily="Arial Black" Margin="332,318,0,0" HorizontalAlignment="Left" Width="293" Height="38" VerticalAlignment="Top"/>
        <Label x:Name="_warehouseManagementTransfersToOrderButton" Content="To order" FontSize="36" Foreground="White" FontFamily="Arial Black" MouseEnter="someButton_MouseEnterYellow" MouseLeave="someButton_MouseLeaveWhite" Margin="20,391,0,0" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Left" Width="186" Height="52" VerticalAlignment="Top" MouseDown="warehouseManagementTransfersToOrderButton_MouseDown">
            <Label.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="0.09"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Label.RenderTransform>
        </Label>
        <Label x:Name="_warehouseManagementTransfersCancelButton" Content="Cancel" FontSize="36" Foreground="White" FontFamily="Arial Black" MouseEnter="someButton_MouseEnterYellow" MouseLeave="someButton_MouseLeaveWhite" Margin="339,393,0,0" HorizontalAlignment="Left" Width="226" Height="52" VerticalAlignment="Top" MouseDown="warehouseManagementTransfersCancelButton_MouseDown"/>
        <Label x:Name="_warehouseManagementTransfersReceiptDateTitleLabel" Content="Receipt date" FontSize="24" Foreground="White" FontFamily="Arial Black" Margin="11,317,0,0" HorizontalAlignment="Left" Width="228" Height="38" VerticalAlignment="Top"/>
        <ListBox x:Name="_contentListBox" Margin="655,126,0,0" Background="#FF111111" Foreground="White" BorderBrush="#FF111111" HorizontalAlignment="Left" Width="387" FontFamily="Arial Black" d:ItemsSource="{d:SampleData ItemCount=5}" Height="230" VerticalAlignment="Top">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Width="356">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0" Margin="0,0,10,0" IsChecked="{Binding IsSelected, Mode=TwoWay}" />

                        <TextBlock Grid.Column="1" 
                           Text="{Binding ProductDescribe}" 
                           FontSize="18" Margin="0,0,12,0"
                           
                           TextTrimming="CharacterEllipsis" 

                           ToolTip="{Binding ProductDescribe}" />

                        <TextBox Grid.Column="1" HorizontalContentAlignment="Center" FontSize="18" Margin="273,0,-51,0" Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </Grid>
</Window>