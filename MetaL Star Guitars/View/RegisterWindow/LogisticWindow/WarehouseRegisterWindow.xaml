<Window x:Class="MetaL_Star_Guitars.WarehouseRegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Warehouses" Height="315" Width="767" Background="#FF252525">

    <Grid x:Name="_mainGrid">

        <Label x:Name="_warehouseManagementWarehouseWarehouseNameTitleLabel" Content="Warehouse name" HorizontalAlignment="Left" Margin="9,78,0,0" VerticalAlignment="Top" FontSize="24" Foreground="White" FontFamily="Arial Black" Width="280"/>

        <Label x:Name="_warehouseManagementWarehouseCapacityTitleLabel" Content="Capacity" Margin="10,117,0,0" VerticalAlignment="Top" FontSize="24" Foreground="White" FontFamily="Arial Black" HorizontalAlignment="Left" Width="139"/>
        <TextBox x:Name="_warehouseManagementWarehouseCapacityTextBox" HorizontalAlignment="Left" Margin="390,128,0,0" VerticalAlignment="Top" Width="346" FontSize="22" FontFamily="Arial Black" Height="31"/>
        <Label
                        Grid.Row="0" x:Name="_warehouseManagementWarehouseWarehouseIdTitleLabel" Margin="10,161,0,0" FontSize="24" FontFamily="Arial Black" Foreground="White" Content="Warehouse ID" Grid.Column="0" Height="38" VerticalAlignment="Top" HorizontalAlignment="Left" Width="187"/>
        <Label
                        Grid.Row="0" x:Name="_warehouseManagementWarehouseWarehouseIdLabel" Margin="392,169,0,0" FontSize="24" FontFamily="Arial Black" Foreground="White" Content="1" HorizontalAlignment="Left" Width="345" Height="38" VerticalAlignment="Top"/>
        <Label
                        x:Name="_warehouseManagementWarehouseWarehouseRegisterButtonLabel" MouseLeave="someButton_MouseLeaveWhite" MouseEnter="someButton_MouseEnterYellow" Margin="9,221,0,0" FontSize="36" FontFamily="Arial Black" Foreground="White" Content="Register" VerticalAlignment="Top" MouseDown="warehouseManagementWarehouseWarehouseRegisterButtonLabel_MouseDown" HorizontalAlignment="Left" Width="188"/>
        <Label
                        x:Name="_warehouseManagementWarehouseWarehouseCancelButtonLabel" MouseLeave="someButton_MouseLeaveWhite" MouseEnter="someButton_MouseEnterYellow" Margin="391,221,0,0" FontSize="36" FontFamily="Arial Black" Foreground="White" Content="Cancel" VerticalAlignment="Top" HorizontalAlignment="Left" Width="346" MouseDown="warehouseManagementWarehouseWarehouseCancelButtonLabel_MouseDown"/>
        <TextBox x:Name="_warehouseManagementWarehouseWarehouseNameTextBox" HorizontalAlignment="Left" Margin="390,85,0,0" VerticalAlignment="Top" Width="346" FontSize="22" FontFamily="Arial Black" Height="31"/>
        <Label x:Name="_warehouseManagementWarehouseWarehouseTitleLabel1" Content="Warehouse" Margin="10,10,0,0" VerticalAlignment="Top" FontSize="36" Foreground="White" FontFamily="Arial Black" Height="56" HorizontalAlignment="Left" Width="247"/>

    </Grid>
</Window>