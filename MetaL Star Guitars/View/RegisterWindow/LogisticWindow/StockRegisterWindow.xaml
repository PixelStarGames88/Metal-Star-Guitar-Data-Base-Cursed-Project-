<Window x:Class="MetaL_Star_Guitars.View.RegisterWindow.LogisticWindow.StockRegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Stock Register Window" Height="306" Width="750" Background="#FF252525">

    <Grid x:Name="_mainGrid">

        <Label x:Name="_warehouseManagementWarehouseWarehouseTitleLabel" Content="Warehouse" HorizontalAlignment="Left" Margin="10,74,0,0" VerticalAlignment="Top" FontSize="24" Foreground="White" FontFamily="Arial Black" Width="324"/>
        <Label x:Name="_warehouseManagementWarehouseProductTitleLabel" Content="Product" Margin="10,118,0,0" VerticalAlignment="Top" FontSize="24" Foreground="White" FontFamily="Arial Black" HorizontalAlignment="Left" Width="194"/>
        <Label
                    Grid.Row="0" x:Name="_warehouseManagementWarehouseQuantityTitleLabel" Margin="10,161,0,0" FontSize="24" FontFamily="Arial Black" Foreground="White" Content="Quantity" Grid.Column="0" HorizontalAlignment="Left" Width="324" Height="38" VerticalAlignment="Top"/>
        <Label
                    x:Name="_warehouseManagementWarehouseStockRegisterButtonLabel" MouseLeave="someButton_MouseLeaveWhite" MouseEnter="someButton_MouseEnterYellow" Margin="10,222,0,0" FontSize="36" FontFamily="Arial Black" Foreground="White" Content="Register" Height="55" VerticalAlignment="Top" MouseDown="warehouseManagementWarehouseStockRegisterButtonLabel_MouseDown" HorizontalAlignment="Left" Width="194"/>
        <Label
                    x:Name="_warehouseManagementWarehouseStockCancelButtonLabel" MouseLeave="someButton_MouseLeaveWhite" MouseEnter="someButton_MouseEnterYellow" Margin="339,222,0,0" FontSize="36" FontFamily="Arial Black" Foreground="White" Content="Cancel" HorizontalAlignment="Left" Width="380" Height="45" VerticalAlignment="Top" MouseDown="warehouseManagementWarehouseStockCancelButtonLabel_MouseDown"/>
        <TextBox x:Name="_warehouseManagementWarehousesQuantityTextBox" HorizontalAlignment="Left" Margin="340,164,0,0" Width="379" FontSize="22" FontFamily="Arial Black" Height="31" VerticalAlignment="Top"/>
        <ComboBox x:Name="_warehouseManagementWarehouseWarehouseComboBox" HorizontalAlignment="Left" Margin="340,77,0,0" Width="379" Background="#FF161616" FontSize="22" FontFamily="Arial Black" Height="31" VerticalAlignment="Top"/>
        <ComboBox x:Name="_warehouseManagementWarehouseProductComboBox" HorizontalAlignment="Left" Margin="340,119,0,0" Width="379" Background="#FF161616" FontSize="22" FontFamily="Arial Black" Height="31" VerticalAlignment="Top"/>
        <Label x:Name="_warehouseManagementWarehouseStockTitleLabel" Content="Stock" Margin="10,11,0,0" FontSize="36" Foreground="White" FontFamily="Arial Black" HorizontalAlignment="Left" Width="709" Height="56" VerticalAlignment="Top"/>

    </Grid>
</Window>