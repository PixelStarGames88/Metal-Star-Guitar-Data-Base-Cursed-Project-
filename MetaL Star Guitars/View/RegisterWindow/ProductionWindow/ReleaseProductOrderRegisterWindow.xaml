<Window x:Class="MetaL_Star_Guitars.View.RegisterWindow.ProductionWindow.ReleaseProductOrderRegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MetaL Star Guitars" Height="456" Width="751" Background="#FF252525">

    <Grid x:Name="_mainGrid">

        <Label x:Name="_productionStagesManagementReleaseProductsTitleLabel" Content="Release products" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" FontSize="36" Foreground="White" FontFamily="Arial Black"/>

        <Label x:Name="_productionStagesManagementReleaseProductsToOrderLabel" Content="For order" HorizontalAlignment="Left" Margin="12,76,0,0" VerticalAlignment="Top" FontSize="24" Foreground="White" FontFamily="Arial Black"/>
        <ComboBox x:Name="_productionStagesManagementReleaseProductsToOrderComboBox" HorizontalAlignment="Left" Margin="337,79,0,0" VerticalAlignment="Top" Width="388" Background="#FF161616" FontSize="22" FontFamily="Arial Black"/>

        <Label x:Name="_productionStagesManagementReleaseProductsToWarehouseLabel" Content="To warehouse" HorizontalAlignment="Left" Margin="12,119,0,0" VerticalAlignment="Top" FontSize="24" Foreground="White" FontFamily="Arial Black"/>
        <ComboBox x:Name="_productionStagesManagementReleaseProductsToWarehouseComboBox" HorizontalAlignment="Left" Margin="337,122,0,0" VerticalAlignment="Top" Width="388" Background="#FF161616" FontSize="22" FontFamily="Arial Black"/>

        <Label x:Name="_productionStagesManagementReleaseProductsProductLabel" Content="Product" HorizontalAlignment="Left" Margin="12,162,0,0" VerticalAlignment="Top" FontSize="24" Foreground="White" FontFamily="Arial Black"/>
        <ComboBox x:Name="_productionStagesManagementReleaseProductsProductComboBox" Margin="337,165,0,0" HorizontalAlignment="Left" Width="305" VerticalAlignment="Top" Background="#FF161616" FontSize="22" FontFamily="Arial Black"/>
        <TextBox x:Name="_productionStagesManagementReleaseProductsQuantityTextBox" HorizontalAlignment="Left" Margin="647,165,0,0" VerticalAlignment="Top" Width="78" FontSize="22" FontFamily="Arial Black" Height="31"/>
        <Label
                        x:Name="_productionStagesManagementReleaseProductsToReleaseButtonLabel" MouseLeave="someButton_MouseLeaveWhite" MouseEnter="someButton_MouseEnterYellow" Margin="10,360,0,0" FontSize="36" FontFamily="Arial Black" Foreground="White" Content="To release" Height="51" VerticalAlignment="Top" HorizontalAlignment="Left" Width="255" MouseDown="productionStagesManagementReleaseProductsToReleaseButtonLabel_MouseDown"/>
        <Label
                        x:Name="_productionStagesManagementReleaseProductsCancelButtonLabel" MouseLeave="someButton_MouseLeaveWhite" MouseEnter="someButton_MouseEnterYellow" Margin="337,360,0,0" FontSize="36" FontFamily="Arial Black" Foreground="White" Content="Cancel" Height="51" VerticalAlignment="Top" HorizontalAlignment="Left" Width="146" MouseDown="productionStagesManagementReleaseProductsCancelButtonLabel_MouseDown"/>
        <Label
                        Grid.Row="0" x:Name="_productionStagesManagementReleaseProductsDocumentIdTitleLabel" Margin="10,205,0,0" FontSize="24" FontFamily="Arial Black" Foreground="White" Content="Document ID" Grid.Column="0" Height="38" VerticalAlignment="Top" HorizontalAlignment="Left" Width="277"/>
        <Label
                        Grid.Row="0" x:Name="_productionStagesManagementReleaseProductsDocumentIdLabel" Margin="337,205,0,0" FontSize="24" FontFamily="Arial Black" Foreground="White" Content="1" Height="38" VerticalAlignment="Top" HorizontalAlignment="Left" Width="388"/>
        <Label
                        x:Name="_productionStagesManagementReleaseProductsTypeTitleLabel" Margin="12,248,0,0" FontSize="24" FontFamily="Arial Black" Foreground="White" Content="Type" Grid.Column="0" Height="37" VerticalAlignment="Top" HorizontalAlignment="Left" Width="277"/>
        <Label
                        x:Name="_productionStagesManagementReleaseProductsDateTitleLabel" Margin="12,290,0,0" FontSize="24" FontFamily="Arial Black" Foreground="White" Content="Date" Grid.Column="0" Height="38" VerticalAlignment="Top" HorizontalAlignment="Left" Width="277"/>
        <Label
                        x:Name="_productionStagesManagementReleaseProductsDateLabel" Margin="337,290,0,0" FontSize="24" FontFamily="Arial Black" Foreground="White" Content="18:45 17.05.2026" Height="38" VerticalAlignment="Top" HorizontalAlignment="Left" Width="388"/>
        <ComboBox x:Name="_productionStagesManagementReleaseProductsTypeComboBox" HorizontalAlignment="Left" Margin="337,251,0,0" VerticalAlignment="Top" Width="388" Background="#FF161616" FontSize="22" FontFamily="Arial Black">
            <ComboBoxItem Content="Finished product output"/>
            <ComboBoxItem Content="Semi-finished product output"/>
        </ComboBox>

    </Grid>
</Window>